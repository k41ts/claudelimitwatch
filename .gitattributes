# Shell scripts must keep LF: CRLF breaks the shebang on Linux
# ("bad interpreter: /usr/bin/env bash^M").
*.sh text eol=lf
# PowerShell is happier with CRLF on Windows.
*.ps1 text eol=crlf
# Everything else: normalise in the repo, native in the working tree.
* text=auto

*.png binary
*.ico binary
*.exe binary
*.zip binary
